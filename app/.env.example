# FOURWALLS — Umgebungsvariablen
# Kopieren nach .env.local (Entwicklung). Niemals eine Datei mit echten
# Geheimnissen einchecken. Diese Beispieldatei enthält nur Entwicklungswerte.

# development | test | staging | production
APP_ENV=development

# PostgreSQL 16 + PostGIS. Entwicklung: der lokale Docker-Container fw-dev-db.
DATABASE_URL=postgres://fourwalls:fourwalls_dev@localhost:55433/fourwalls

# Öffentliche Basisadresse (für canonical, hreflang, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Objektspeicher. Entwicklung: local (Dateien unter public/media).
# Produktion später: s3 (S3-kompatibel; Zugang ausschliesslich serverseitig).
STORAGE_PROVIDER=local

# E-Mail. Entwicklung: dev (schreibt nach var/mail/ und ins Protokoll, versendet nichts).
MAIL_PROVIDER=dev
MAIL_FROM=noreply@fourwalls.example
# Empfängerin für Anfragen ohne auflösbare Anbieterseite (nur Entwicklung/Staging).
MAIL_DEV_SINK=dev-sink@fourwalls.example

# Nur ausserhalb der Entwicklung erforderlich — die Anwendung startet dort
# ohne diese Werte NICHT (fail closed). Mindestens 32 Zeichen.
# APP_SECRET=

# ---------- P5.5: Objektspeicher (STORAGE_PROVIDER=s3) ----------
# Zwei Behälter: privat (Originale, Unveröffentlichtes) und öffentlich (Ableitungen
# veröffentlichter Bilder). Anbieter steckt nur hier: Exoscale SOS, MinIO, …
# S3_ENDPOINT=https://sos-ch-gva-2.exo.io
# S3_REGION=ch-gva-2
# S3_BUCKET_PRIVATE=fw-staging-privat
# S3_BUCKET_PUBLIC=fw-staging-oeffentlich
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=nein            # MinIO lokal: ja
# S3_PUBLIC_BASE_URL=                  # optional, sonst aus Endpunkt + Behälter

# ---------- P5.5: authentifizierter SMTP-Versand (MAIL_PROVIDER=smtp) ----------
# SMTP_HOST=mail.infomaniak.com
# SMTP_PORT=587
# SMTP_TLS=starttls                    # 465: tls
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_VERIFY_CERT=ja                  # nein NUR in der Entwicklung (Mail-Attrappe)

# ---------- P5.5: Staging-Zugangsschleuse (nur APP_ENV=staging) ----------
# STAGING_GATE_USER=
# STAGING_GATE_PASSWORD=               # mindestens 16 Zeichen

# Outbox-Arbeiter (Millisekunden zwischen zwei Durchläufen)
# OUTBOX_INTERVAL_MS=15000
