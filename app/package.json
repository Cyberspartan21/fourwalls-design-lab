{
  "name": "fourwalls-app",
  "version": "0.5.2",
  "private": true,
  "description": "Fourwalls — Produktionsanwendung. P5.2: Fundament und erste senkrechte Scheibe (eine Objektseite aus der Datenbank).",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'tests/*.test.ts'",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/migrate.mjs --seed",
    "db:test": "node scripts/migrate.mjs --test",
    "check:slice": "node scripts/slice-check.mjs",
    "db:import": "node scripts/import-demo.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.2",
    "next": "16.3.4",
    "pg": "8.16.3",
    "postgres": "3.4.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
